# Copie para production.env e mantenha o arquivo real fora do Git.
COMPOSE_PROJECT_NAME=openfinance-production
REGISTRY_IMAGE=ghcr.io/sabbasistemas/openfinance
IMAGE_TAG=sha-REPLACE_WITH_COMMIT_SHA

APP_NAME="OpenFinance Platform"
APP_KEY=base64:REPLACE_WITH_32_BYTE_KEY
APP_PREVIOUS_KEYS=
APP_URL=https://openfinance.example.com
SESSION_DOMAIN=.openfinance.example.com
TRUSTED_PROXIES=*
LOG_LEVEL=info
BCRYPT_ROUNDS=12

# Endpoint de escrita do PgBouncer/HAProxy na rede WireGuard.
DB_HOST=10.60.0.20
DB_PORT=6432
DB_DATABASE=openfinance
DB_USERNAME=openfinance
DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
DB_SSLMODE=require

# Endpoint virtual do Redis Sentinel ou proxy de failover.
REDIS_HOST=10.60.0.30
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD
REDIS_DB=0
REDIS_CACHE_DB=1

MINIO_ACCESS_KEY=REPLACE_WITH_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=REPLACE_WITH_MINIO_SECRET_KEY
MINIO_ENDPOINT=https://minio.internal.example.com
MINIO_RAW_BUCKET=openfinance-raw

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=REPLACE_WITH_SMTP_USERNAME
MAIL_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.com

METRICS_TOKEN=REPLACE_WITH_RANDOM_METRICS_TOKEN
HTTP_BIND_ADDRESS=0.0.0.0
HTTP_PORT=8080
DEPLOY_HEALTH_URL=http://127.0.0.1:8080/api/v1/health

