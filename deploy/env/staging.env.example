# Copie para staging.env. Este stack inclui PostgreSQL, Redis e MinIO.
COMPOSE_PROJECT_NAME=openfinance-staging
REGISTRY_IMAGE=ghcr.io/sabbasistemas/openfinance
IMAGE_TAG=sha-REPLACE_WITH_COMMIT_SHA

APP_KEY=base64:REPLACE_WITH_32_BYTE_KEY
APP_URL=https://staging-openfinance.example.com
APP_DEBUG=false
TRUSTED_PROXIES=*
LOG_LEVEL=info

POSTGRES_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD
MINIO_ACCESS_KEY=openfinance-staging
MINIO_SECRET_KEY=REPLACE_WITH_MINIO_SECRET_KEY
METRICS_TOKEN=REPLACE_WITH_RANDOM_METRICS_TOKEN

HTTP_BIND_ADDRESS=0.0.0.0
HTTP_PORT=8080
ADMIN_BIND_ADDRESS=127.0.0.1
MINIO_CONSOLE_PORT=9001
DEPLOY_HEALTH_URL=http://127.0.0.1:8080/api/v1/health

